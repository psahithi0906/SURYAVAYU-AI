# FIX #2: Set the API base URL for non-Docker deployments (local dev, Vercel, Netlify, etc.)
# For Docker, this is overridden by docker-compose.yml (REACT_APP_API_BASE_URL=http://backend:8000)
# For local development without Docker, backend runs on http://localhost:8000
REACT_APP_API_BASE_URL=http://localhost:8000
